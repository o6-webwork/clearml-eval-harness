# Copy to `.env` in this folder (docker compose auto-loads it) and fill in
# your real token. `.env` is git-ignored; `.env.example` is safe to commit.

# HuggingFace token — required for gated models (Unbabel/XCOMET-XL,
# google/gemma-4-E2B-it, etc). Request access on the model pages first, then
# create a read-only token at https://huggingface.co/settings/tokens.
HF_TOKEN=hf_REPLACE_ME
