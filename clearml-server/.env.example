# Tailscale IP or hostname of this machine (the one running the ClearML server).
# Every agent and the pipeline controller use this to reach the server.
# Example: 100.64.0.1  or  my-dgx
CLEARML_HOST=100.124.225.71

# Optional: pre-set API credentials so all agents share the same key pair.
# Generate from the ClearML web UI → Settings → Workspace → Create credentials,
# then paste them here. If left blank, you'll create them via the UI on first login.
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
